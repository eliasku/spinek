{
  "name": "spinek",
  "version": "0.1.1",
  "description": "TypeScript Spine 4.3 runtime with WebGL, Canvas and ek3d renderers",
  "license": "LicenseRef-Spine-Runtimes",
  "author": "Ilya Kuzmichev <eliasku.games@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasku/spinek.git"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vp test",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "npm run lint && npm run typecheck",
    "verify": "npm run check && npm test && npm run build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eliasku/ts-mangle": "^0.2.4",
    "@types/node": "^26.6.6",
    "ek3d": "^0.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "peerDependencies": {
    "ek3d": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "ek3d": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@12.2.2"
}
