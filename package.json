{
  "name": "spinek",
  "version": "0.1.0",
  "description": "TypeScript Spine 4.3 runtime with WebGL, Canvas and ek3d renderers",
  "license": "LicenseRef-Spine-Runtimes",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "OPTIMIZE_PLAN.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build:examples": "vp build",
    "preview": "vp preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "npm run typecheck && npm test && npm run build:examples"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "ek3d": "file:../ek3d",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "ek3d": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "ek3d": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.17.0"
}
