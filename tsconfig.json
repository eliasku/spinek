{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "spinek": ["./src/index.ts"],
      "spinek/webgl": ["./src/webgl/index.ts"],
      "spinek/canvas": ["./src/canvas/index.ts"],
      "spinek/ek3d": ["./src/ek3d/index.ts"]
    }
  },
  "include": ["src", "examples", "tests", "vite.config.ts"]
}
